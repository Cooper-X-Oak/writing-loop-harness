# Copy to .env for local experiments. Never commit real .env files.

# Provider selection for future LLM adapters.
WRITING_LOOP_PROVIDER=openai
WRITING_LOOP_DEFAULT_MODEL=
WRITING_LOOP_EMBEDDING_MODEL=

# API keys for future adapters. Current v1 does not call model APIs.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Runtime limits.
WRITING_LOOP_MAX_OUTPUT_TOKENS=4096
WRITING_LOOP_TIMEOUT_MS=120000
WRITING_LOOP_LOG_LEVEL=info

# Optional caller workspace for a concrete hotspot writing deployment.
HOTSPOT_WORKSPACE_ROOT=
HOTSPOT_SOURCE_REGISTRY=
HOTSPOT_DAILY_MAIN_ARTICLE_LIMIT=1
HOTSPOT_DAILY_MAX_PUBLISHABLE_DRAFTS=2
HOTSPOT_FRESHNESS_HOURS=6

# Optional adapters for concrete deployments.
HOTSPOT_WRITER_ADAPTER=
HOTSPOT_IMAGE_PROVIDER=
